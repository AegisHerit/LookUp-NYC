# Copy these into your host's environment settings (Render, Railway, etc.). Never commit real values.
VONAGE_API_KEY=your_key_from_dashboard.nexmo.com
VONAGE_API_SECRET=your_secret
# The Vonage number texts come from, digits only with country code, e.g. 12015550123
VONAGE_FROM=12015550123
# Sites allowed to call the server (comma separated). localhost is always allowed for testing.
ALLOWED_ORIGINS=https://aegisherit.github.io
SITE_URL=https://aegisherit.github.io/LookUp-NYC/
# Set to 1 to print texts in the log instead of sending them
DRY_RUN=0
